# Alan adı bağlandığında: SITE_ADDRESS=turnuva.example.com ve BASE_URL=https://turnuva.example.com
SITE_ADDRESS=:80
BASE_URL=http://SUNUCU_IP

# Gizli değerler — sunucuda `openssl rand -hex 32` ile üretilip buraya yazılır.
# PASSWORD_SECRET bir kez belirlenir, sonra ASLA değiştirilmez.
POSTGRES_PASSWORD=
SESSION_SECRET=
PASSWORD_SECRET=
BGAMMON_WEBHOOK_SECRET=

# E-posta gönderimi (opsiyonel — boşsa sistem e-posta göndermez)
# Microsoft 365: smtp.office365.com / 587  (kutuda "Authenticated SMTP" açık olmalı)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
